{
  "name": "playwright-scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright POC: unattended Salesforce login under phishing-resistant MFA (JWT Bearer + frontdoor.jsp + virtual passkey)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:bootstrap": "playwright test --project=bootstrap",
    "test:bootstrap:headed": "playwright test --project=bootstrap --headed",
    "test": "playwright test --project=unattended",
    "test:app": "playwright test --project=app"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "typescript": "^5.9.0"
  }
}
