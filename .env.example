# Copy to .env (git-ignored) and fill in. Never put real values in this file.
# Production use requires written security sign-off — see docs/prmfa-playwright-spike.htm §6.

# OAuth login host: https://login.salesforce.com, https://test.salesforce.com (sandbox), or your My Domain URL
SF_LOGIN_URL=https://login.salesforce.com
# Connected App consumer key / secret (web server flow)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Callback URL registered on the Connected App (intercepted by Playwright; nothing needs to listen on it)
SF_CALLBACK_URL=http://localhost:8080/callback
# Salesforce user the tests log in as (must be pre-authorized on the Connected App)
SF_USERNAME=
SF_PASSWORD=
# Where the serialized passkey (a full MFA factor — treat like a signing key) is stored
PASSKEY_STORE_PATH=./.secrets/passkey.json
# Page to open after authentication
SF_RETURN_PATH=/lightning/page/home
# Max time (ms) to wait for each login step
SF_LOGIN_TIMEOUT_MS=60000
